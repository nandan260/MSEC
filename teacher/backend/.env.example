# Hosted OpenAI-compatible provider. Keys stay on the backend.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# Local alternative: AI_BASE_URL=http://localhost:11434/v1 and AI_MODEL=<tool-capable-model>
# Local providers do not require AI_API_KEY. Within Docker use host.docker.internal.
YOUTUBE_API_KEY=
PORT=8000

# Output/reasoning budget (1000–32000); increase for reasoning-heavy teaching models.
AI_MAX_TOKENS=8000
